<Page
    x:Class="Kronos.Pages.GameGridPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ct_converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:converters="using:Kronos.Converters"
    xmlns:data="using:Kronos.Data"
    xmlns:system="using:System"
    xmlns:pages="using:Kronos.Pages"
    xmlns:usercontrols="using:Kronos.UserControls"
    mc:Ignorable="d"
    d:DataContext="pages:GameGridPageModel"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    NavigationCacheMode="Required"
    x:Name="RootGameGridPage">

    <!--
    Ctrl+F focuses the search box.

    On the page rather than on the TextBox, because the search box is not a button that runs a command -
    it is a control that has to take focus. Attached to the TextBox itself the accelerator would be
    shadowed by the very field it is meant to jump to, since a focused TextBox consumes character input
    before the accelerator on it is reached.
    -->
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchAccelerator_Invoked" />
    </Page.KeyboardAccelerators>
    <Page.Resources>
        <ct_converters:BoolNegationConverter x:Key="BoolNegationConverter" />
        <ct_converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" TrueValue="Visible" FalseValue="Collapsed" />
        <ct_converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" TrueValue="Collapsed" FalseValue="Visible" />
        <ct_converters:StringVisibilityConverter x:Key="StringVisibilityConverter" EmptyValue="Collapsed" NotEmptyValue="Visible" />
        <ct_converters:StringVisibilityConverter x:Key="InverseStringVisibilityConverter" EmptyValue="Visible" NotEmptyValue="Collapsed" />
        <converters:BitmapImageUriConverter x:Key="BitmapImageUriConverter" />
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" TrueValue="0.25" FalseValue="1.0" NullValue="1.0" />
        



        <!-- One game row, shared by every library section of the list view below. -->
        <DataTemplate x:Key="GameRowTemplate" x:DataType="data:Game">
            <Grid ColumnSpacing="12" Opacity="{x:Bind IsHidden, Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="80" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" BorderThickness="0" CornerRadius="4" Width="40" Height="60" FlowDirection="LeftToRight">
                    <Border.RenderTransform>
                        <CompositeTransform ScaleX="1" />
                    </Border.RenderTransform>
                    <Border.Background>
                        <ImageBrush Stretch="UniformToFill">
                            <ImageBrush.ImageSource>
                                <BitmapImage CreateOptions="IgnoreImageCache" UriSource="{x:Bind CoverImage, Mode=OneWay, Converter={StaticResource BitmapImageUriConverter}}"/>
                            </ImageBrush.ImageSource>
                        </ImageBrush>
                    </Border.Background>
                </Border>

                <!--
                Title and repack tag are stacked rather than overlaid.

                They used to be two children of Grid.Column="2", with the tag at
                VerticalAlignment="Bottom" and the title at VerticalAlignment="Center". Both
                were positioned against the fixed 80px row, not against each other, so the tag
                sat well below a single-line title and detached from it, and overlapped the
                second line once the title wrapped. A negative bottom margin pushed it past the
                row edge as well.

                A StackPanel makes the tag follow the text it belongs to at whatever height the
                title happens to take, and keeps the pair centred as a unit. The positive
                top margin replaces the negative one, so the tag adds spacing instead of
                hanging outside the row.
                -->
                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextWrapping="Wrap" />
                    <!-- Only shown when the user has flagged this install as a repack. See RepackDetector. -->
                    <Border HorizontalAlignment="Left"
                            Padding="4,1" CornerRadius="3" Margin="0,4,0,0"
                            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                            Visibility="{x:Bind IsRepack, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                            ToolTipService.ToolTip="Flagged as a repack (scene release). Swapped DLLs may be ignored by the repack's own launcher.">
                        <TextBlock Text="REPACK" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                </StackPanel>
                <ProgressRing Grid.Column="2" VerticalAlignment="Center" Width="16" Height="16" Visibility="{x:Bind Processing, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                <TextBlock Grid.Column="3" VerticalAlignment="Center">
                    <Run Text="DLSS: " />
                    <Run Text="{x:Bind CurrentDLSS.DisplayName, FallbackValue='N/A', Mode=OneWay}" />
                </TextBlock>

            </Grid>

        </DataTemplate>

        <!--
        The list view, one section per library. Uno's ListView does not draw GroupStyle headers either, so
        it is laid out the same way as the grid view below: see the comment there.
        -->
        <DataTemplate x:Key="ListViewTemplate" x:DataType="pages:GameGridPageModel">
            <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{x:Bind CurrentCollectionView.CollectionGroups, Mode=OneWay}" Padding="20">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Visibility="{Binding Group.HasGames, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,12">
                                <TextBlock Text="{Binding Group.Name}" Margin="12,0,0,4" Style="{StaticResource TitleTextBlockStyle}"
                                           Visibility="{Binding Group.Name, Converter={StaticResource StringVisibilityConverter}}" />
                                <ListView ItemsSource="{Binding Group.Games}"
                                          ItemTemplate="{StaticResource GameRowTemplate}"
                                          HorizontalAlignment="Stretch" SelectionMode="None" IsItemClickEnabled="True" ItemClick="GridAndListView_ItemClick"
                                          ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DataTemplate>

        <!-- One game tile, shared by every library section of the grid view below. -->
        <!--
        The container has its own template, without the default GridViewItem press animation.

        That animation (PointerDownThemeAnimation) shrinks and tilts the whole item while it is pressed.
        On Uno's Skia renderer the cover art visibly jittered on every click, on every poster - and the
        click itself caused no layout, scrolling or list change, which was checked with logging. This
        template keeps the hover highlight and the click, and drops the press transform.
        -->
        <Style x:Key="GameTileContainerStyle" TargetType="GridViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewItem">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="HoverOverlay.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="HoverOverlay.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <Border x:Name="HoverOverlay" Opacity="0" CornerRadius="8" IsHitTestVisible="False"
                                    BorderThickness="2" BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="GameTileTemplate" x:DataType="data:Game">
            <Grid 
                Width="{Binding ElementName=RootGameGridPage, Path=ViewModel.GridViewItemWidth, Mode=OneWay}"
                Height="{Binding ElementName=RootGameGridPage, Path=ViewModel.GridViewItemHeight, Mode=OneWay}"
                CornerRadius="8" Opacity="{x:Bind IsHidden, Mode=OneWay, Converter={StaticResource BoolToOpacityConverter}}" BorderThickness="1" ColumnSpacing="0" RowSpacing="0" Margin="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="{x:Bind Title, Mode=OneWay}" Margin="20" TextWrapping="WrapWholeWords" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{ThemeResource ButtonForegroundColor}" />

                <!-- Weird, but allows image to strecth centered rather than left align -->

                <!--
                IsHitTestVisible="False" on this and the bar below.

                Grid draws later children on top, and this Border has no width, height or
                alignment, so it stretches over the entire tile. That does not matter for a
                click, because every point on the tile should open the game - but anything
                that does need the mouse has to be excluded explicitly, because being drawn
                on top and swallowing input is the default.

                The tile had a selection checkbox here, which could not be reached at all for
                this reason. There is no longer a selection.
                -->
                <Border BorderThickness="0" FlowDirection="LeftToRight" IsHitTestVisible="False">
                    <Border.RenderTransform>
                        <CompositeTransform ScaleX="1" />
                    </Border.RenderTransform>
                    <Border.Background>
                        <ImageBrush Stretch="UniformToFill">
                            <ImageBrush.ImageSource>
                                <BitmapImage CreateOptions="IgnoreImageCache" UriSource="{x:Bind CoverImage, Mode=OneWay, Converter={StaticResource BitmapImageUriConverter}}"/>
                            </ImageBrush.ImageSource>
                        </ImageBrush>
                    </Border.Background>
                </Border>

                <Grid VerticalAlignment="Bottom"  Background="#88000000" Padding="8" ColumnSpacing="8" IsHitTestVisible="False">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Column="0" FontWeight="Bold" Text="DLSS" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="White" />
                    <TextBlock Grid.Column="1" Text="{x:Bind CurrentDLSS.DisplayName, FallbackValue='N/A', Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="White" Visibility="{x:Bind Processing, Converter={StaticResource InverseBoolToVisibilityConverter}, Mode=OneWay}" />
                    <ProgressRing Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="White" Width="16" Height="16" Visibility="{x:Bind Processing, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                </Grid>
            </Grid>
        </DataTemplate>

        <!--
        The grid view, one section per library, each with its own header.

        This used to be a single GridView over the grouped CollectionView, with a GroupStyle header, so
        WinUI's ItemsWrapGrid laid out a header and a wrapping block of tiles for each library. Uno does not
        implement ItemsWrapGrid: on desktop its GridView falls back to a plain WrapPanel, which knows
        nothing about groups. Every library's tiles then ran together in one block with no headers, and
        Steam and Xbox games were indistinguishable. Measured: IsGrouping was true and the view reported
        all nine groups, but the panel was a WrapPanel and not one header container existed.

        So the sections are laid out here instead: the view's CollectionGroups, each a header and a
        non-scrolling GridView over that library's games, inside one ScrollViewer. Empty libraries are
        collapsed, which GroupStyle.HidesIfEmpty used to do. The tiles are the same template as before.
        -->
        <DataTemplate x:Key="GridVeiwTemplate" x:DataType="pages:GameGridPageModel">
            <ScrollViewer PointerWheelChanged="MainGridView_PointerWheelChanged" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MainGridView" ItemsSource="{x:Bind CurrentCollectionView.CollectionGroups, Mode=OneWay}" Padding="20">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Visibility="{Binding Group.HasGames, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,12">
                                <TextBlock Text="{Binding Group.Name}" Margin="8,0,0,4" Style="{StaticResource TitleTextBlockStyle}"
                                           Visibility="{Binding Group.Name, Converter={StaticResource StringVisibilityConverter}}" />
                                <GridView ItemsSource="{Binding Group.Games}"
                                          ItemTemplate="{StaticResource GameTileTemplate}"
                                          ItemContainerStyle="{StaticResource GameTileContainerStyle}"
                                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="GridAndListView_ItemClick"
                                          ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                          ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DataTemplate>

        <usercontrols:ListGridViewTemplateSelector x:Key="TemplateSelector"
                                  ListViewTemplate="{StaticResource ListViewTemplate}"
                                  GridVeiwTemplate="{StaticResource GridVeiwTemplate}"/>
        
    </Page.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="16,0,16,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="16">
                <TextBlock Text="{x:Bind ViewModel.TranslationProperties.PageTitle, Mode=OneWay}" Margin="16,0,0,0" TextWrapping="NoWrap" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                <muxc:ProgressRing IsActive="True" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"  />

                <!--
                A count, not just a spinner.

                Games were being scanned with no indication of how many were left, and a game being scanned
                cannot be opened - clicking it says "Game Currently Processing". So a large library showed
                an unexplained wait with no way to tell whether it had nearly finished or was stuck. This
                says how much is actually happening.

                Visibility is bound to the same source as the spinner so the two never disagree.
                -->
                <TextBlock
                    VerticalAlignment="Center"
                    Opacity="0.7"
                    Text="{x:Bind ViewModel.ScanStatusText, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.ScanStatusText, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Grid Width="300" Margin="10,0,0,0">
                    <TextBox x:Name="SearchBox"
                        Height="20"
                        Padding="8,5,32,0"
                        AcceptsReturn="True"
                        IsEnabled="{x:Bind ViewModel.IsGameListLoading, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                        PlaceholderText="{x:Bind ViewModel.TranslationProperties.SearchText, Mode=OneWay}"
                        TextChanged="{x:Bind ViewModel.SearchForGameEvent}" />

                    <Button x:Name="ClearButton"
                            Width="26"
                            Height="26"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Margin="0,0,4,0"
                            Padding="4"
                            Visibility="{x:Bind SearchBox.Text, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}"
                            Click="ClearSearchBox_Click">
                        <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                    </Button>
                </Grid>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                <AppBarButton Label="{x:Bind ViewModel.TranslationProperties.NewDllsText, Mode=OneWay}" Command="{x:Bind ViewModel.UnknownAssetsFoundButtonCommand}" Visibility="{x:Bind data:GameManager.Instance.UnknownAssetsFound, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" IsEnabled="{x:Bind ViewModel.IsGameListLoading, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}">
                    <AppBarButton.Content>
                        <FontIcon Glyph="&#xE946;" />
                    </AppBarButton.Content>
                </AppBarButton>
                <AppBarButton Label="{x:Bind ViewModel.TranslationProperties.AddGameText, Mode=OneWay}" Command="{x:Bind ViewModel.AddManualGameButtonCommand}" IsEnabled="{x:Bind ViewModel.IsGameListLoading, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}">
                    <AppBarButton.Content>
                        <FontIcon Glyph="&#xE710;" />
                    </AppBarButton.Content>
                </AppBarButton>
                <!-- IsEnabled binds to CanRefresh, not to the negation of IsLoading. CanRefresh adds the
                     command's own re-entrancy guard, so the button is disabled by the same condition
                     that makes a second refresh a no-op. Binding to IsLoading alone left the button
                     enabled whenever that flag disagreed with the guard. -->
                <AppBarButton Label="{x:Bind ViewModel.TranslationProperties.RefreshText, Mode=OneWay}" Command="{x:Bind ViewModel.RefreshGamesButtonCommand}" IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}">
                    <!--
                    Ctrl+R. The accelerator lives on the button, so it runs the same command the button does
                    and inherits the button's enabled state - there is no second path to the command that
                    can disagree about whether a refresh is allowed.
                    -->
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="R" Modifiers="Control" />
                    </AppBarButton.KeyboardAccelerators>
                    <AppBarButton.Content>
                        <FontIcon Glyph="&#xE72C;" />
                    </AppBarButton.Content>
                </AppBarButton>
                <!--
                Mass update. Acts on the whole library, so it has no selection to be disabled by and
                no flyout - "Select all shown" and "Clear selection" described a selection that no
                longer exists.

                Disabled only while a run is in progress. What it will do is named in the tooltip, and
                the full plan is shown before anything is written.
                -->
                <AppBarButton Label="Update all" Icon="Sync"
                              Command="{x:Bind ViewModel.MassUpgrade.RunMassUpgradeCommand}"
                              IsEnabled="{x:Bind ViewModel.MassUpgrade.CanUpdate, Mode=OneWay}"
                              ToolTipService.ToolTip="{x:Bind ViewModel.MassUpgrade.TargetDescription, Mode=OneWay}">
                    <AppBarButton.Content>
                        <FontIcon Glyph="&#xE895;" />
                    </AppBarButton.Content>
                </AppBarButton>

                <AppBarButton Icon="Filter" Label="{x:Bind ViewModel.TranslationProperties.FilterText, Mode=OneWay}" Command="{x:Bind ViewModel.FilterGamesButtonCommand}" IsEnabled="{x:Bind ViewModel.IsGameListLoading, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}">
                    <AppBarButton.Content>
                        <FontIcon Glyph="&#xE71C;" />
                    </AppBarButton.Content>
                </AppBarButton>
                <AppBarButton Label="{x:Bind ViewModel.TranslationProperties.ViewTypeText, Mode=OneWay}" Content="{x:Bind ViewModel.GameGridViewIcon, Mode=OneWay}">
                    <AppBarButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="{x:Bind ViewModel.TranslationProperties.GridViewText, Mode=OneWay}" Command="{x:Bind ViewModel.ChangeGameGridViewCommand}" CommandParameter="{x:Bind pages:GameGridViewType.GridView}" />
                            <MenuFlyoutItem Text="{x:Bind ViewModel.TranslationProperties.ListViewText, Mode=OneWay}" Command="{x:Bind ViewModel.ChangeGameGridViewCommand}" CommandParameter="{x:Bind pages:GameGridViewType.ListView}" />
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
            </StackPanel>

            <InfoBar x:Name="AdminInfoBar"
                 Grid.Row="1"
                 IsOpen="True"
                 Severity="Warning"
                 IsClosable="False"
                 Title="Warning"
                 Message="{x:Bind ViewModel.TranslationProperties.ApplicationRunsInAdministrativeModeInfo, Mode=OneWay}"
                 Visibility="{x:Bind system:Environment.IsPrivilegedProcess, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>

        <ContentControl x:Name="MainContentControl" Grid.Row="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch" Content="{x:Bind ViewModel, Mode=OneWay}" ContentTemplateSelector="{StaticResource TemplateSelector}" />
        
    </Grid>
</Page>
