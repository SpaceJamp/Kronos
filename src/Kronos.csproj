    <Compile Include="Helpers\FSR31\FxxConsts.cs" />
    <Compile Include="Data\DLLAssetTypeInfo.cs" />
    <Compile Include="Data\Steam\SteamCoverUrlResolver.cs" />

    <!-- Extensions -->
    <Compile Include="Extensions\FileVersionInfoExtensions.cs" />
    <Compile Include="Extensions\VersionExtensions.cs" />
    <Compile Include="Extensions\FileStreamExtensions.cs" />

    <!-- Interfaces -->
    <Compile Include="Interfaces\IGameLibrary.cs" />

    <!-- JSON Converters -->
    <Compile Include="JsonConverters\HexStringToUintConverter.cs" />

    <!-- Language -->
    <Compile Include="Language\TranslationRow.cs" />

    <!--
      Translations for the Linux target. On Windows these .resw files are compiled by the XAML
      compiler into a PRI that ResourceHelper reads through WinUI's ResourceManager; there is no PRI
      here, so ResourceHelper parses the XML directly. It has to be copied to the output directory
      rather than embedded, because it looks for it at Translations/<language>/Resources.resw next
      to the executable.
    -->
    <Content Include="Translations\**\*.resw" CopyToOutputDirectory="PreserveNewest" />

    <!-- Messages -->
    <Compile Include="Messages\GameLibrariesStateChangedMessage.cs" />
    <Compile Include="Messages\GameLibrariesOrderChangedMessage.cs" />

    <!-- Attributes -->
    <Compile Include="Attributes\TranslationPropertyAttribute.cs" />

    <!-- EA App (cross-platform data models) -->
    <Compile Include="Data\EAApp\GameSearchResult.cs" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release' OR '$(Configuration)'=='Release_Portable'">
    <Optimize>True</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug_Portable'">
    <DefineConstants>$(DefineConstants);DEBUG;PORTABLE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release_Portable'">
    <DefineConstants>$(DefineConstants);RELEASE;PORTABLE</DefineConstants>
    <!--
      WinExe, not Exe. The portable configuration used to override the output type to Exe, which is the
      *console* subsystem: launching Kronos then opened a black command prompt window behind the app and
      left it there for as long as the app ran. The Windows target framework already sets WinExe at the
      top of this file, and this group was silently undoing it for the one configuration that gets
      shipped to users.

      Console output is not wanted here anyway. Serilog.Sinks.Console is referenced and its writes
      simply go nowhere without an attached console, which is the right outcome - the app logs to its
      own log file under the storage folder.
    -->
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

