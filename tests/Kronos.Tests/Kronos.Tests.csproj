<Project Sdk="Uno.Sdk">

  <PropertyGroup>
    <!--
      Uno.Sdk and net10.0-desktop, to match src/Kronos.csproj. A plain Microsoft.NET.Sdk project cannot
      reference it: "desktop" is a target platform only Uno.Sdk knows, so restore rejects the reference
      as incompatible. The Uno version comes from global.json.
    -->
    <TargetFramework>net10.0-desktop</TargetFramework>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>Kronos.Tests</RootNamespace>
    <AssemblyName>Kronos.Tests</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- These tests exercise plain logic, not XAML. -->
    <SelfContained>false</SelfContained>
    <!-- Same suppressions as src/Kronos.csproj; see there. -->
    <NoWarn>$(NoWarn);NU1507;NETSDK1201;PRI257</NoWarn>

    <!--
    Same auditing and lock file as src/Kronos.csproj, and for the same reasons. The test project has
    its own package graph, including xunit and the test host, which is separate from the app's and
    would not be covered by auditing the app alone.
    -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kronos.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
