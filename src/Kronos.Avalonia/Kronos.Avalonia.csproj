<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Kronos.Avalonia</AssemblyName>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <RootNamespace>Kronos</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationIcon>Assets/icon.ico</ApplicationIcon>
    <Version>1.50</Version>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.0" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.8" />
    <PackageReference Include="sqlite-net-e" Version="1.11.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageReference Include="ValveKeyValue" Version="0.70.0.499" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kronos.csproj" />
  </ItemGroup>

  <!-- Include all source files explicitly since EnableDefaultCompileItems=false -->
  <ItemGroup Condition="'$(TargetFramework)'=='net10.0'">
    <Compile Include="App.axaml.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="Models\Models.cs" />
    <Compile Include="Converters\Converters.cs" />
    <Compile Include="Services\Interfaces.cs" />
    <Compile Include="Services\Implementations.cs" />
    <Compile Include="ViewModels\UpdatesViewModel.cs" />
    <Compile Include="ViewModels\SettingsViewModel.cs" />
    <Compile Include="ViewModels\MainWindowViewModel.cs" />
    <Compile Include="ViewModels\LibraryViewModel.cs" />
    <Compile Include="ViewModels\GameItemViewModel.cs" />
    <Compile Include="ViewModels\ChangelogViewModel.cs" />
    <Compile Include="ViewModels\AddGameDialogViewModel.cs" />
    <Compile Include="Views\MainWindow.axaml.cs" />
    <Compile Include="Views\LibraryView.axaml.cs" />
    <Compile Include="Views\SettingsView.axaml.cs" />
    <Compile Include="Views\SettingsWindow.axaml.cs" />
    <Compile Include="Views\ChangelogWindow.axaml.cs" />
    <Compile Include="Views\UpdatesView.axaml.cs" />
    <Compile Include="Views\AddGameDialog.axaml.cs" />
    <Compile Include="Platform\Abstractions.cs" />
    <Compile Include="Platform\Implementations.cs" />
    <Compile Include="..\Storage.cs" />
    <Compile Include="..\Platforms\Linux\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kronos.csproj" />
  </ItemGroup>
</Project>