<Page x:Class="Kronos.UnoSpike.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ct_converters="using:CommunityToolkit.WinUI.Converters"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      mc:Ignorable="d"
      d:DataContext="local:ProbeViewModel"
      xmlns:local="using:Kronos.UnoSpike"
      NavigationCacheMode="Required"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!--
    The probe.

    Every construct here is one Kronos uses today, in the shape Kronos uses it. Nothing is invented
    to be hard; the list came from reading src/Pages/SettingsPage.xaml and src/Pages/GameGridPage.xaml.

    Grouped by what could go wrong:
      - the Windows-only WinUI Community Toolkit converters, used on every Kronos page
      - WinUI system brushes and styles from ThemeResource / StaticResource
      - x:Bind through a nested TranslationProperties object, which is how every string in the app is
        actually bound
      - the control set the settings and games pages are built from
      - ObservableProperty + RelayCommand, the whole MVVM layer
    -->

    <Page.Resources>
        <!-- Declared per-page in Kronos, exactly as here. -->
        <ct_converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" TrueValue="Visible" FalseValue="Collapsed" />
        <ct_converters:BoolToVisibilityConverter x:Key="BoolToNegationVisibilityConverter" TrueValue="Collapsed" FalseValue="Visible" />
        <ct_converters:BoolNegationConverter x:Key="BoolNegationConverter" />
        <ct_converters:StringVisibilityConverter x:Key="StringVisibilityConverter" EmptyValue="Collapsed" NotEmptyValue="Visible" />

        <!-- Kronos defines these itself in App.xaml, so they would carry over. -->
        <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">

            <!-- === 1. x:Bind, including two levels deep through TranslationProperties === -->
            <TextBlock Text="{x:Bind ViewModel.TranslationProperties.PageTitleText, Mode=OneWay}"
                       Style="{StaticResource TitleTextBlockStyle}" />

            <TextBlock Text="{x:Bind ViewModel.TranslationProperties.RefreshText, Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       Visibility="{x:Bind ViewModel.StatusText, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}" />

            <!-- === 2. ObservableProperty + RelayCommand === -->
            <AppBarButton Label="{x:Bind ViewModel.TranslationProperties.RefreshText, Mode=OneWay}"
                          Command="{x:Bind ViewModel.DoSomethingCommand}"
                          IsEnabled="{x:Bind ViewModel.IsEnabledFlag, Mode=OneWay}">
                <AppBarButton.Content>
                    <FontIcon Glyph="&#xE72C;" />
                </AppBarButton.Content>
            </AppBarButton>

            <!-- === 3. WinUI system brushes via ThemeResource === -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Padding="12">
                <TextBlock Text="Card" />
            </Border>

            <InfoBar IsOpen="True"
                     Severity="Informational"
                     Title="Information"
                     Message="InfoBar, used on the games page"
                     Background="{ThemeResource SystemFillColorCriticalBrush}" />

            <!-- === 4. WinUI system styles via StaticResource === -->
            <Button Content="Default button style" Style="{StaticResource DefaultButtonStyle}" />
            <Button Content="Accent button style" Style="{StaticResource AccentButtonStyle}" />

            <!-- === 5. The settings control set === -->
            <TextBlock Text="{x:Bind ViewModel.TranslationProperties.ThemeModeText, Mode=OneWay}"
                       Style="{ThemeResource CaptionTextBlockStyle}" />

            <ComboBox ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                      SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
                      HorizontalAlignment="Left" />

            <ToggleSwitch Header="Toggle" IsOn="{x:Bind ViewModel.IsEnabledFlag, Mode=TwoWay}" />

            <CheckBox Content="CheckBox" IsChecked="{x:Bind ViewModel.IsEnabledFlag, Mode=TwoWay}" />

            <RadioButton GroupName="Probe" Content="Radio" />

            <Expander Header="Expander">
                <TextBlock Text="Expander content" />
            </Expander>

            <muxc:ProgressRing IsActive="True"
                               Width="16"
                               Height="16"
                               Visibility="{x:Bind ViewModel.IsEnabledFlag, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />

            <muxc:ProgressBar Value="{x:Bind ViewModel.Progress, Mode=OneWay}" Maximum="100" />

            <!--
            Wrapping a Run, which is what all four Hyperlinks in Kronos do.

            The first version of this probe put a TextBlock inside, and it failed to compile: Uno's
            Hyperlink derives from Inline and takes Inline children, where WinUI 3 also accepts a
            UIElement. Not a real incompatibility - no Kronos page uses the TextBlock form - but it is
            the kind of thing worth knowing before a port rather than during one.
            -->
            <TextBlock TextWrapping="Wrap">
                <Run Text="RichTextBlock with a Run, and a " />
                <Hyperlink NavigateUri="https://github.com/SpaceJamp/Kronos">
                    <Run Text="Hyperlink wrapping a Run" />
                </Hyperlink>
                <Run Text="." />
            </TextBlock>

            <!-- === 6. DataTemplate with x:DataType, as both list templates use === -->
            <ListView ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                      SelectionMode="None"
                      MaxHeight="120">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Text="PROBE COMPLETE" FontWeight="Bold" />

        </StackPanel>
    </ScrollViewer>
</Page>
