<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kronos.ViewModels"
        xmlns:views="using:Kronos.Views"
        x:Class="Kronos.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Kronos - DLSS/FSR/XeSS DLL Swapper"
        Width="1200"
        Height="800"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/icon.ico">

  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <DockPanel>
    <!-- Toolbar -->
    <ToolBarTray DockPanel.Dock="Top">
      <ToolBar>
        <Button Content="Refresh" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh game list" />
        <Button Content="Check Updates" Command="{Binding CheckUpdatesCommand}" ToolTip.Tip="Check for DLL updates" />
        <Separator />
        <Button Content="Settings" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Open settings" />
        <Button Content="Add Game" Command="{Binding AddGameCommand}" ToolTip.Tip="Manually add a game" />
      </ToolBar>
    </ToolBarTray>

    <!-- Status Bar -->
    <StatusBar DockPanel.Dock="Bottom">
      <StatusBar.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </StatusBar.ItemsPanel>
      <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="8,0" />
      <ProgressBar Value="{Binding ProgressValue}" IsVisible="{Binding IsBusy}" Width="200" Margin="8,0" />
      <TextBlock Text="{Binding ProgressText}" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" Margin="8,0" />
    </StatusBar>

    <!-- Main Content -->
    <TabControl SelectedIndex="{Binding SelectedTabIndex}">
      <!-- Library Tab -->
      <TabItem Header="Library">
        <views:LibraryView DataContext="{Binding LibraryViewModel}" />
      </TabItem>

      <!-- Updates Tab -->
      <TabItem Header="Updates">
        <views:UpdatesView DataContext="{Binding UpdatesViewModel}" />
      </TabItem>

      <!-- Settings Tab -->
      <TabItem Header="Settings">
        <views:SettingsView DataContext="{Binding SettingsViewModel}" />
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>