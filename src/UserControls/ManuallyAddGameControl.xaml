<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Kronos.UserControls.ManuallyAddGameControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kronos.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Width="200" Height="300" CornerRadius="8" BorderThickness="1" ColumnSpacing="0" RowSpacing="0" Margin="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">

            <!-- Hidden once there is a cover, so the placeholder text does not sit on top of the
                 poster. Auto-detected store covers make this reachable without the user doing
                 anything at all, which is why it matters. -->
            <TextBlock TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{ThemeResource ButtonForegroundColor}"
                       Visibility="{Binding HasCoverImage, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <Run Text="{x:Bind ViewModel.TranslationProperties.AddCoverText, Mode=OneWay}" />
                <LineBreak />
                <Run Text="{x:Bind ViewModel.TranslationProperties.OptionalText, Mode=OneWay}" />
            </TextBlock>

            <!-- Weird, but allows image to strecth centered rather than left align -->
            <Border BorderThickness="0" Width="200" Height="300" FlowDirection="LeftToRight">
                <Border.RenderTransform>
                    <CompositeTransform ScaleX="1" />
                </Border.RenderTransform>
                <Border.Background>
                    <ImageBrush Stretch="UniformToFill">
                        <ImageBrush.ImageSource>
                            <BitmapImage CreateOptions="IgnoreImageCache" UriSource="{Binding Game.CoverImage, Mode=OneWay}"/>
                        </ImageBrush.ImageSource>
                    </ImageBrush>
                </Border.Background>
            </Border>

            <Button HorizontalAlignment="Stretch" Background="Transparent" VerticalAlignment="Stretch" Command="{Binding AddCoverImageCommand}" AllowDrop="True" DragEnter="CoverButton_DragEnter" DragOver="CoverButton_DragOver" Drop="CoverButton_Drop" />
        </Grid>

        <StackPanel Orientation="Vertical" Spacing="4" Grid.Column="1">
            <TextBlock Text="{x:Bind ViewModel.TranslationProperties.NameText, Mode=OneWay}" FontWeight="Bold" />
            <TextBox Text="{Binding Game.Title}" />
            <TextBlock Text="{x:Bind ViewModel.TranslationProperties.InstallPathText, Mode=OneWay}" FontWeight="Bold" Padding="0,20,0,0" />
            <TextBox IsReadOnly="True" Text="{Binding Game.InstallPath}" />
            <!--
                Pre-ticked by RepackDetector when the folder carries repack or emulation markers,
                but it stays an ordinary checkbox the user can untick. Detection is only a
                suggestion; this flag is what the rest of the app acts on.
            -->
            <CheckBox Content="This is a repack (scene release)"
                      Margin="0,16,0,0"
                      IsChecked="{Binding Game.IsRepack, Mode=TwoWay}" />

            <!--
                A manually added game has no store page to fetch artwork from, so the tile is
                blank unless the user supplies an image or the appid is known. The appid is
                detected automatically and the cover previewed next to this field, so a wrong match
                is visible before the game is added. A dropped image still wins over the store one.
            -->
            <TextBlock Text="Store app id" FontWeight="Bold" Padding="0,20,0,0" />
            <TextBox Text="{Binding Game.LinkedAppId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="detected automatically, or type e.g. 3669870" />
            <TextBlock TextWrapping="Wrap"
                       Opacity="0.7"
                       FontSize="12"
                       Padding="0,4,0,0"
                       Text="The Steam app id of the game this is a copy of. Kronos looks this up from the folder name and downloads that game's cover art. Correct it if the preview on the left is wrong." />
        </StackPanel>
    </Grid>
</UserControl>
