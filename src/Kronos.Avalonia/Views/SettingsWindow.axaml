<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kronos.ViewModels"
        x:Class="Kronos.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="600"
        Height="500"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

  <DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16" Spacing="8">
      <Button Content="View Changelog" Command="{Binding ShowChangelogCommand}" />
      <Button Content="Reset to Defaults" Command="{Binding ResetToDefaultsCommand}" />
      <Button Content="Cancel" IsCancel="True" />
      <Button Content="Save" IsDefault="True" Classes="Accent" Command="{Binding SaveCommand}" />
    </StackPanel>

    <ScrollViewer Margin="24">
      <StackPanel Spacing="24">
        <TextBlock Text="Settings" FontSize="24" FontWeight="Bold" />

        <Border Classes="Card" Padding="16" Margin="0,8">
          <StackPanel Spacing="16">
            <TextBlock Text="Downloads" FontWeight="Medium" FontSize="16" />

            <StackPanel Spacing="8">
              <TextBlock Text="Download Folder" FontWeight="Medium" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding DownloadPath, Mode=TwoWay}" IsReadOnly="True" />
                <Button Content="Browse..." Command="{Binding BrowseDownloadPathCommand}" />
              </Grid>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="16">
              <NumericUpDown Value="{Binding MaxConcurrentDownloads, Mode=TwoWay}" Minimum="1" Maximum="8" Width="100" />
              <TextBlock Text="Max Concurrent Downloads" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="Card" Padding="16">
          <StackPanel Spacing="16">
            <TextBlock Text="DLL Verification" FontWeight="Medium" FontSize="16" />

            <CheckBox Content="Verify DLL signatures (recommended)" IsChecked="{Binding CheckSignatures, Mode=TwoWay}" />
            <CheckBox Content="Allow untrusted DLLs (not recommended)" IsChecked="{Binding AllowUntrusted, Mode=TwoWay}" />
          </StackPanel>
        </Border>

        <Border Classes="Card" Padding="16">
          <StackPanel Spacing="16">
            <TextBlock Text="Updates" FontWeight="Medium" FontSize="16" />

            <CheckBox Content="Automatically check for updates on startup" IsChecked="{Binding AutoCheckUpdates, Mode=TwoWay}" />
          </StackPanel>
        </Border>

        <Border Classes="Card" Padding="16">
          <StackPanel Spacing="16">
            <TextBlock Text="Ignored Paths" FontWeight="Medium" FontSize="16" />
            <TextBlock Text="Games in these folders will not be scanned." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding NewIgnoredPath, Mode=TwoWay}" Watermark="/path/to/ignore" />
                <Button Content="Add" Command="{Binding AddIgnoredPathCommand}" />
              </Grid>

              <ItemsControl ItemsSource="{Binding IgnoredPaths}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                      <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                      <Button Content="Remove" Command="{Binding $parent[Window].DataContext.RemoveIgnoredPathCommand}" CommandParameter="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>