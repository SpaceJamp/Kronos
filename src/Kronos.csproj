    <!--
      Only the game *models* from these libraries, not the libraries themselves. GameManager
      pattern-matches on XboxGame/BattleNetGame when launching a title; the discovery code that
      reads WindowsApps and product.db is registry and Windows-path bound, so it stays excluded.
    -->
    <Compile Include="Data\Xbox\XboxGame.cs" />
    <Compile Include="Data\BattleNet\BattleNetGame.cs" />
    <Compile Include="Updater.cs" />

    <!-- Core data models (no UI dependencies) -->
    <Compile Include="Data\GameAssetType.cs" />
    <Compile Include="Data\DLLImportResult.cs" />
    <Compile Include="Data\KnownDLLs.cs" />
    <Compile Include="Data\HashedKnownDLL.cs" />
    <Compile Include="Data\GameLibrarySettings.cs" />
    <Compile Include="Data\LocalRecord.cs" />
    <Compile Include="Data\NVIDIA\ListBucketResult.cs" />
    <Compile Include="Data\NVIDIA\ListBucketResultContents.cs" />
    <Compile Include="Data\Steam\SteamStateFlag.cs" />
    <Compile Include="Data\Steam\Manifest\LibraryFoldersVDF.cs" />
    <Compile Include="Data\Steam\SteamAPI\*.cs" />
    <Compile Include="Data\Steam\Manifest\AppManifestACF.cs" />
    <Compile Include="Data\GitHub\GitHubTypes.cs" />
    

    <!-- Helpers (cross-platform only) -->
    <Compile Include="UiDispatcher.cs" />
    <Compile Include="Http.cs" />
    <Compile Include="Helpers\PathHelpers.cs" />
    <Compile Include="Helpers\LanguageManager.cs" />
    <Compile Include="Helpers\DllBackupStack.cs" />
    <Compile Include="Helpers\RepackDetector.cs" />
    <Compile Include="Helpers\CommonHelpers.cs" />
    <Compile Include="Helpers\FileDownloader.cs" />
    <Compile Include="Helpers\ResourceHelper.cs" />
