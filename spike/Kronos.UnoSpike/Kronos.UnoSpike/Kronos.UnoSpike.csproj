<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>Kronos.UnoSpike</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.companyname.kronos-unospike</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>Kronos.UnoSpike</ApplicationPublisher>
    <!-- Package Description -->
    <Description>Kronos.UnoSpike powered by Uno Platform.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      Lottie;
      Toolkit;
      Mvvm;
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

  <ItemGroup>
    <!--
    The package the whole migration hinges on. Every Kronos page declares these converters in its own
    resources and binds through them, so if they do not work here they do not work there.

    This is the Windows-only WinUI Community Toolkit rather than the cross-platform one, which is
    precisely why it has to be tested rather than assumed.
    -->
    <PackageReference Include="CommunityToolkit.WinUI.Converters" />
    <PackageReference Include="CommunityToolkit.WinUI.Collections" />
  </ItemGroup>

</Project>
