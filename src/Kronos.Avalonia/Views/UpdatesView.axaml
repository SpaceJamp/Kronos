<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kronos.ViewModels"
             x:Class="Kronos.Views.UpdatesView"
             x:DataType="vm:UpdatesViewModel">

  <StackPanel Margin="24" Spacing="16">
    <TextBlock Text="Application Updates" FontSize="24" FontWeight="Bold" />

    <Border Classes="Card" Padding="16" Margin="0,8">
      <StackPanel Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="16">
          <StackPanel>
            <TextBlock Text="Current Version" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{Binding CurrentVersion}" FontSize="18" FontWeight="Medium" />
          </StackPanel>
          <StackPanel Margin="32,0,0,0">
            <TextBlock Text="Latest Version" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{Binding LatestVersion}" FontSize="18" FontWeight="Medium"
                       Foreground="{Binding UpdateAvailable, Converter={StaticResource BoolToColorConverter}, ConverterParameter=Green;Red}" />
          </StackPanel>
        </StackPanel>

        <Button Content="{Binding IsChecking, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Check Updates;Checking...'}"
                Command="{Binding CheckForUpdatesCommand}"
                IsEnabled="{Binding IsChecking, Converter={StaticResource InverseBoolConverter}}"
                HorizontalAlignment="Left"
                Margin="0,8,0,0" />

        <Separator IsVisible="{Binding UpdateAvailable}" Margin="0,16,0,8" />

        <StackPanel IsVisible="{Binding UpdateAvailable}" Spacing="8">
          <TextBlock Text="Release Notes:" FontWeight="Medium" />
          <ScrollViewer MaxHeight="200">
            <TextBlock Text="{Binding ReleaseNotes}" TextWrapping="Wrap" />
          </ScrollViewer>

          <Button Content="Download and Apply Update"
                  Command="{Binding ApplyUpdateCommand}"
                  IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBoolConverter}}"
                  HorizontalAlignment="Left"
                  Margin="0,16,0,0" />

          <ProgressBar Value="{Binding DownloadProgress}" Height="8"
                       IsVisible="{Binding IsDownloading}"
                       Margin="0,8,0,0" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="Card" Padding="16">
      <StackPanel Spacing="8">
        <TextBlock Text="Auto-Update Settings" FontWeight="Medium" FontSize="16" />
        <CheckBox Content="Automatically check for updates on startup" IsChecked="{Binding AutoCheckUpdates}" />
        <CheckBox Content="Include pre-release versions" IsChecked="{Binding IncludePrerelease}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>