<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Kronos</AssemblyName>
    <TargetFrameworks>net10.0;net10.0-windows10.0.26100.0</TargetFrameworks>
    <SixLaborsLicenseKey>$([System.Environment]::GetEnvironmentVariable('IMAGESHARP_LICENSE_KEY'))</SixLaborsLicenseKey>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <!--
      RootNamespace matches AssemblyName. They are kept in step deliberately: the embedded resource
      names are derived from the root namespace, and AcknowledgementsPageModel and DLLManager both
      look resources up by name, so letting the two drift silently breaks the static manifest
      (the app then refuses to start) and empties the acknowledgements page.
  
      The storage folder in Storage.cs is "Kronos" rather than the original "DLSS Swapper" for the
      same reason: this is a separate program and should not read or write another product's data.
    -->
    <RootNamespace>Kronos</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      x64 only, deliberately. The app downloads 64-bit nvngx_dlss.dll, nvngx_dlssg.dll, amd_fidelityfx_dx12.dll
      and the rest to swap into games, so there is nothing useful it could do on a 32-bit Windows. A
      32-bit OS also cannot load this binary at all, and App.OnLaunched shows an explanation when
      Environment.Is64BitOperatingSystem is false rather than letting the loader fail obscurely.
    -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <Prefer32Bit>false</Prefer32Bit>

    <!--
    Dependency auditing, and a lock file so a build resolves to the same package versions next month
    as it does today.

    NuGetAuditMode is "all" rather than the default "direct" because "direct" only looks at the
    PackageReferences in this file, and an advisory usually arrives through a transitive dependency.
    That is the whole class of problem that went unnoticed on the Ruby side, where all 30 alerts came
    from docs/Gemfile.lock and none from anything named in a manifest.

    Audits are warnings, not errors, and are deliberately left that way. Failing the build on any
    advisory would let a transitive one inside a Microsoft package that cannot be fixed here break
    every build, which is how a guard gets switched off. The full graph is currently clean, so today
    this reports nothing; when it does report something it appears in the CI log next to the build.

    RestorePackagesWithLockFile writes src/packages.lock.json, which must be committed. It is what
    Dependabot reads for transitive coverage, and what pins the graph. If a PackageReference changes,
    restore updates the lock and the new one has to be committed with it.
    -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Configurations>Debug;Release;Debug_Portable;Release_Portable</Configurations>
    <PackageIcon>Assets\icon_256.png</PackageIcon>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <!--
      Bumped to 1.52 for the Games page / DLL reset / data-loss fixes. This must match the git tag
      or the in-app and CLI updater will compare against the wrong version: it reads the release
      title, and CheckForUpdateAsync only offers a release strictly newer than this number.
      Kept in step with Kronos.Avalonia.csproj.
    -->
    <Version>1.52</Version>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishReadyToRunShowWarnings>false</PublishReadyToRunShowWarnings>
    <CETCompat>false</CETCompat>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)'=='net10.0'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunShowWarnings>true</PublishReadyToRunShowWarnings>
  </PropertyGroup>

  <!--
  Build metadata, injected at compile time and read back by src\BuildInfo.cs.

  BuildInfo.GitBranch, GitCommit, GitTag and BuildTimestamp were auto properties that nothing ever
  assigned, so the Settings page showed a build date of 1 January 1970, because the timestamp was 0
  and FromUnixTimeSeconds(0) is the epoch. The commit was blank for the same reason.

  Written into the assembly as attributes rather than as a generated source file, so there is no
  generated file to be stale, out of date with the build, or committed by accident.

  This has to be a TARGET, not a bare ItemGroup. A bare ItemGroup is evaluated when the project is
  loaded, which is before the SDK has run InitializeSourceControlInformation and assigned
  SourceRevisionId, so $(SourceRevisionId) expanded to nothing and KronosGitCommit was written as an
  empty string. The informational version still showed the commit, because that is assembled during
  GenerateAssemblyInfo, long after evaluation. Injecting at BeforeTargets="GetAssemblyAttributes" is
  therefore both necessary and sufficient.

  SourceRevisionId comes from the git checkout, so the commit is populated even for a build made
  straight from an IDE. The branch and tag are passed in by the build scripts with -p:, because MSBuild
  cannot run git while evaluating properties, and both are optional: a build from an archive with no
  git available leaves them empty, which is why BuildInfo treats an empty tag as "not a release build"
  rather than as an error.
  -->
  <Target Name="AddKronosBuildMetadata" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <AssemblyMetadata Include="KronosGitBranch" Value="$(KronosGitBranch)" />
      <AssemblyMetadata Include="KronosGitCommit" Value="$(SourceRevisionId)" />
      <AssemblyMetadata Include="KronosGitTag" Value="$(KronosGitTag)" />
      <AssemblyMetadata Include="KronosBuildTimestamp" Value="$([System.DateTime]::UtcNow.ToString(&quot;o&quot;))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!--
    So the tests can reach internal types such as BuildInfo without those becoming part of the app's
    public surface. Helpers that predate this were simply made public instead, which is why DllBackupStack
    and MassUpgradePlanner are public while BuildInfo is not.

    BuildInfo needs it for ParseTimestamp, which is the part with real logic in it. The four properties
    cannot be usefully asserted on from a test anyway, because they are read once from this assembly's
    own attributes, so a test would only ever be reading the values of the build it is running in.
    -->
    <InternalsVisibleTo Include="Kronos.Tests" />
  </ItemGroup>

