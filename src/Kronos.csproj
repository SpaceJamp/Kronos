<Project Sdk="Uno.Sdk">
  <!--
    Uno Platform, not Windows App SDK. The Uno.Sdk version is pinned in the repository's global.json
    (msbuild-sdks), to the same version spike/Kronos.UnoSpike proved the XAML on; do not float it.

    One target framework, net10.0-desktop, for both Windows and Linux. Which operating system the
    build is for is decided by the runtime identifier rather than by the target framework - see the
    WINDOWS / LINUX group below - so the 36 #if WINDOWS blocks keep meaning what they meant before.
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop</TargetFrameworks>
    <OutputType>WinExe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <!--
      SkiaRenderer only. The spike also enabled Lottie, Toolkit and Mvvm; Kronos uses none of the first
      two, and the Mvvm feature would add an implicit CommunityToolkit.Mvvm that fights the explicitly
      versioned one below.
    -->
    <UnoFeatures>SkiaRenderer;</UnoFeatures>
    <!--
      Uno has no generated Main on desktop: the host is built by hand in UnoProgram.cs. On Linux the
      CLI in Program.cs also has a Main, so the startup object has to be named.
    -->
    <StartupObject>Kronos.UnoProgram</StartupObject>
    <ApplicationTitle>Kronos</ApplicationTitle>
    <ApplicationId>com.kronos.app</ApplicationId>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <ApplicationPublisher>Kronos</ApplicationPublisher>

    <AssemblyName>Kronos</AssemblyName>
    <SixLaborsLicenseKey>$([System.Environment]::GetEnvironmentVariable('IMAGESHARP_LICENSE_KEY'))</SixLaborsLicenseKey>
    <!--
      RootNamespace matches AssemblyName. They are kept in step deliberately: the embedded resource
      names are derived from the root namespace, and AcknowledgementsPageModel and DLLManager both
      look resources up by name, so letting the two drift silently breaks the static manifest
      (the app then refuses to start) and empties the acknowledgements page.

      The storage folder in Storage.cs is "Kronos" rather than the original "DLSS Swapper" for the
      same reason: this is a separate program and should not read or write another product's data.
    -->
    <RootNamespace>Kronos</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      x64 only, deliberately. The app downloads 64-bit nvngx_dlss.dll, nvngx_dlssg.dll, amd_fidelityfx_dx12.dll
      and the rest to swap into games, so there is nothing useful it could do on a 32-bit Windows. A
      32-bit OS also cannot load this binary at all, and App.OnLaunched shows an explanation when
      Environment.Is64BitOperatingSystem is false rather than letting the loader fail obscurely.
    -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <Prefer32Bit>false</Prefer32Bit>

    <!--
    Dependency auditing, and a lock file so a build resolves to the same package versions next month
    as it does today.

    NuGetAuditMode is "all" rather than the default "direct" because "direct" only looks at the
    PackageReferences in this file, and an advisory usually arrives through a transitive dependency.
    That is the whole class of problem that went unnoticed on the Ruby side, where all 30 alerts came
    from docs/Gemfile.lock and none from anything named in a manifest.

    Audits are warnings, not errors, and are deliberately left that way. Failing the build on any
    advisory would let a transitive one inside a Microsoft package that cannot be fixed here break
    every build, which is how a guard gets switched off. The full graph is currently clean, so today
    this reports nothing; when it does report something it appears in the CI log next to the build.

    RestorePackagesWithLockFile writes src/packages.lock.json, which must be committed. It is what
    Dependabot reads for transitive coverage, and what pins the graph. If a PackageReference changes,
    restore updates the lock and the new one has to be committed with it.
    -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!--
      Release_Portable is gone. It existed because WinAppSDK could only be published unpackaged under a
      configuration of its own; Uno has no such constraint. The PORTABLE define it carried now comes
      from the KronosPortable property further down.
    -->
    <Configurations>Debug;Release;Debug_Portable</Configurations>
    <PackageIcon>Assets\icon_256.png</PackageIcon>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <!--
      Bumped to 1.61, which carries a startup-crash fix that 1.60 does not have. The bug was mine and it
      was in the source for a few days: registering a Ctrl+, accelerator on the root grid from
      MainWindow's constructor fail-fasts inside Microsoft.UI.Xaml.dll, so the app died during launch
      with no exception, no log and no window. 1.60 predates it and is unaffected.

      It survived because build.ps1's smoke test - which starts the published binary and fails the
      build if it dies - called a Fail function that was never defined in that script. The test worked;
      it detected the crash and then died reporting it, after the build had already printed a green
      line. Both are fixed, and both now have tests.

      This must match the git tag or the updater will compare against the wrong version: it reads the
      release title, and the comparison only offers a release strictly newer than this number.

      This is now the single source of truth for the version. The Avalonia project, which used to have
      to be kept in step with it, has been removed.
    -->
    <Version>1.61</Version>
    <!--
      Uno's DevServer strips the assembly version attributes from Debug builds, so hot reload does not
      trip over them, and every Debug build then reports itself as 0.0.0.0 - in the log header, and to
      the updater, which compares against it. A true version matters more here than hot reload.
    -->
    <UnoDisableGenerateAssemblyInfoWorkaround>true</UnoDisableGenerateAssemblyInfoWorkaround>
    <!--
      Uno.Sdk defaults this to false. Logger and BuildInfo read the commit from the "+hash" suffix of the
      informational version, so without it every build logs "commit: none (not a git build)".
    -->
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishReadyToRunShowWarnings>false</PublishReadyToRunShowWarnings>
    <CETCompat>false</CETCompat>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      NU1507: several package sources (nuget.org and the Toolkit Labs feed in nuget.config).
      NETSDK1201: specifying a RID no longer implies self-contained.
      PRI257: the default language (en) is not one of the included resources (en-US etc.).
      Same set the Uno template, and so the spike, suppresses.
    -->
    <NoWarn>$(NoWarn);NU1507;NETSDK1201;PRI257</NoWarn>
  </PropertyGroup>

  <!--
    WINDOWS or LINUX, from the runtime identifier.

    These used to come from the target framework: net10.0-windows10.0.26100.0 defined WINDOWS and
    net10.0 defined LINUX. With one net10.0-desktop target framework for both, the runtime identifier
    is the only thing left that says which operating system a build is for. A build with no runtime
    identifier is for the machine doing the building.
  -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win')) Or ('$(RuntimeIdentifier)'=='' And $([MSBuild]::IsOSPlatform('Windows')))">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    <KronosTargetsWindows>true</KronosTargetsWindows>
  </PropertyGroup>
  <PropertyGroup Condition="'$(KronosTargetsWindows)'!='true'">
    <DefineConstants>$(DefineConstants);LINUX</DefineConstants>
  </PropertyGroup>

  <!--
    The Linux command-line interface and its self-updater. Excluded from Windows builds exactly as the
    old net10.0-windows target excluded them; the GUI's GitHubUpdater covers Windows.
  -->
  <ItemGroup Condition="'$(KronosTargetsWindows)'=='true'">
    <Compile Remove="Program.cs" />
    <Compile Remove="Updater.cs" />
  </ItemGroup>

  <!--
    Excluded everywhere. Its GitHubRelease collides with Data/GitHub/GitHubRelease.cs now that Linux
    compiles the GUI too, and it was already dead on Linux: Updater.cs declares its own Kronos.GitHubRelease
    and GitHubAsset, which shadow these.
  -->
  <ItemGroup>
    <Compile Remove="Data\GitHub\GitHubTypes.cs" />
  </ItemGroup>

  <!--
  Build metadata, injected at compile time and read back by src\BuildInfo.cs.

  BuildInfo.GitBranch, GitCommit, GitTag and BuildTimestamp were auto properties that nothing ever
  assigned, so the Settings page showed a build date of 1 January 1970, because the timestamp was 0
  and FromUnixTimeSeconds(0) is the epoch. The commit was blank for the same reason.

  Written into the assembly as attributes rather than as a generated source file, so there is no
  generated file to be stale, out of date with the build, or committed by accident.

  This has to be a TARGET, not a bare ItemGroup. A bare ItemGroup is evaluated when the project is
  loaded, which is before the SDK has run InitializeSourceControlInformation and assigned
  SourceRevisionId, so $(SourceRevisionId) expanded to nothing and KronosGitCommit was written as an
  empty string. The informational version still showed the commit, because that is assembled during
  GenerateAssemblyInfo, long after evaluation. Injecting at BeforeTargets="GetAssemblyAttributes" is
  therefore both necessary and sufficient.

  SourceRevisionId comes from the git checkout, so the commit is populated even for a build made
  straight from an IDE. The branch and tag are passed in by the build scripts with -p:, because MSBuild
  cannot run git while evaluating properties, and both are optional: a build from an archive with no
  git available leaves them empty, which is why BuildInfo treats an empty tag as "not a release build"
  rather than as an error.
  -->
  <Target Name="AddKronosBuildMetadata" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <AssemblyMetadata Include="KronosGitBranch" Value="$(KronosGitBranch)" />
      <AssemblyMetadata Include="KronosGitCommit" Value="$(SourceRevisionId)" />
      <AssemblyMetadata Include="KronosGitTag" Value="$(KronosGitTag)" />
      <AssemblyMetadata Include="KronosBuildTimestamp" Value="$([System.DateTime]::UtcNow.ToString(&quot;o&quot;))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!--
    So the tests can reach internal types such as BuildInfo without those becoming part of the app's
    public surface. Helpers that predate this were simply made public instead, which is why DllBackupStack
    and MassUpgradePlanner are public while BuildInfo is not.

    BuildInfo needs it for ParseTimestamp, which is the part with real logic in it. The four properties
    cannot be usefully asserted on from a test anyway, because they are read once from this assembly's
    own attributes, so a test would only ever be reading the values of the build it is running in.
    -->
    <InternalsVisibleTo Include="Kronos.Tests" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug_Portable'">
    <DefineConstants>$(DefineConstants);DEBUG;PORTABLE</DefineConstants>
  </PropertyGroup>

  <!--
    The portable build: build.ps1 publishes the release zip with -c Release -p:KronosPortable=true.

    PORTABLE used to come from the Release_Portable configuration, which existed only because WinAppSDK
    could not publish unpackaged any other way. The define is what matters, not the configuration: it
    keeps the user's data in StoredData beside the executable, enables the portable self-update, and
    compiles out the updater's -installer.exe branch, which would look for an asset a portable release
    never publishes. A property keeps that without bringing back a configuration Uno has no use for.
  -->
  <PropertyGroup Condition="'$(KronosPortable)'=='true'">
    <DefineConstants>$(DefineConstants);PORTABLE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Acknowledgements\**\notes.md" />
    <EmbeddedResource Include="Acknowledgements\**\license.txt" />
    <Content Remove="Assets\static_manifest.json" />
    <EmbeddedResource Include="Assets\static_manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <!--
      Read from disk next to the executable (NVAPIHelper, EAAppLibrary), so copied rather than embedded.
    -->
    <Content Update="Assets\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="Assets\Fonts\Segoe-Fluent-Icons.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="Assets\icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="Assets\icon_256.png" CopyToOutputDirectory="PreserveNewest" />
    <!--
      Translations are read at runtime from Translations/<language>/Resources.resw next to the
      executable, by ResourceHelper on Linux and by the .resw-backed ResourceLoader on Windows.
    -->
    <Content Include="Translations\**\*.resw" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AsyncAwaitBestPractices" Version="10.0.0" />
    <PackageReference Include="AsyncAwaitBestPractices.MVVM" Version="10.0.0" />
    <PackageReference Include="ByteSize" Version="2.1.2" />
    <!--
      Markdown for the update dialogs and the acknowledgements, rendered by UserControls/MarkdownView.
      Replaces CommunityToolkit.Labs.WinUI.Controls.MarkdownTextBlock, which ships only net*-windows
      assets and has no Uno build.
    -->
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="FuzzySharp" Version="2.0.2" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="CommunityToolkit.WinUI.Collections" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Converters" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Extensions" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Helpers" Version="8.2.251219" />
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <!--
    Microsoft.Web.WebView2 is gone. It was referenced only to lift WinAppSDK's transitive dependency past
    an unlisted version (NU1102), and nothing in src/ used it. Under Uno it is actively harmful: its
    CoreWebView2 collides with Uno.UI's own type of the same name in the generated bindable metadata
    (CS0433), so it had to go in phase 1 rather than phase 2.
    -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.298">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Nito.AsyncEx" Version="5.1.2" />
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.2" />
    <PackageReference Include="NvAPIWrapper.Net" Version="0.8.1.101" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SourceGear.sqlite3" Version="3.50.4.5" />
    <PackageReference Include="sqlite-net-e" Version="1.11.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.9" />
    <PackageReference Include="System.Management" Version="10.0.9" />
    <PackageReference Include="ValveKeyValue" Version="0.70.0.499" />
    <!--
      The only grid. It ships a real Uno build (net10.0 against Uno.WinUI) beside its Windows App SDK
      one, so it runs on both. The translation toolbox used CommunityToolkit's DataGrid, whose only Uno
      build is an unmaintained net7.0 one compiled against Uno 5; it was moved onto TableView instead.
    -->
    <PackageReference Include="WinUI.TableView" Version="1.4.1" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

</Project>
